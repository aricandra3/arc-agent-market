# Copy to `.env` (gitignored) and fill in. Never commit real values.

# --- Arc Testnet ---
ARC_RPC_URL=https://rpc.testnet.arc.network
ARCSCAN_API_KEY=
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- Deploy key ---
# Treat this as disposable: it only needs enough balance to deploy. Generate it
# in your wallet (or `cast wallet new`) — never paste a key into a chat, an
# issue, or a shared doc.
PRIVATE_KEY=

# --- Long-term owner ---
# Cold wallet or multisig that ends up owning the contracts. Contracts use
# Ownable2Step, so deploy only *initiates* the transfer — this address must then
# call acceptOwnership() on each contract.
#
# Leave blank and the deploy key stays owner: it keeps admin rights AND receives
# every platform fee, so a leak of that one key compromises the protocol.
# Must differ from the deploy key's address.
#
# This is an ADDRESS: 0x + 40 hex characters (20 bytes).
# A 0x + 64 hex value (32 bytes) is a private key or a tx hash — do NOT put one
# here. Deploy refuses to start on a malformed value, and never echoes it.
OWNER_ADDRESS=

# --- Deployed addresses ---
# Written automatically to deployments/<network>.json by scripts/deploy.js.
# These are only needed by the standalone helper scripts.
AGENT_REGISTRY_ADDRESS=
TASK_ESCROW_ADDRESS=
MICRO_PAYMENT_ADDRESS=
REPUTATION_ADDRESS=
VERIFIER_REGISTRY_ADDRESS=
WORK_RECEIPT_ADDRESS=
