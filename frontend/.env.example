# ExAgora frontend environment
# Copy this file to `.env.local` and fill in the values.
#
# Every variable is optional — anything left blank falls back to the defaults in
# src/lib/contracts.ts. After a redeploy, take the addresses from
# `deployments/<network>.json` (printed by scripts/deploy.js).

# WalletConnect / Reown project ID — required for the WalletConnect (QR / mobile)
# option in the Connect Wallet modal. Get one for free at https://cloud.reown.com
# (formerly cloud.walletconnect.com). Injected browser wallets (EIP-6963) work
# without this; only WalletConnect needs it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Chain ---
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# --- Contracts ---
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TASK_ESCROW_ADDRESS=
NEXT_PUBLIC_MICRO_PAYMENT_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=

# Powers the verified-work receipt panels. Left blank, the UI hides those
# sections instead of showing empty verification stats.
NEXT_PUBLIC_VERIFIER_REGISTRY_ADDRESS=
NEXT_PUBLIC_WORK_RECEIPT_ADDRESS=

# Arc's native USDC precompile — only change this for a local chain.
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
